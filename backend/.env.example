# Copy to .env and fill in for production. Local dev/demo works with none of
# these set - it defaults to SQLite + the mock insight provider.

DATABASE_PATH=./subsense.db

# "mock" (default, no API calls, deterministic rule-based insights) or "vertex-ai"
INSIGHT_PROVIDER=mock

# Only needed if INSIGHT_PROVIDER=vertex-ai
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Days of no logged usage before a subscription gets auto-flagged
UNUSED_SUBSCRIPTION_DAYS=45
